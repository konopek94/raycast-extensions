{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "sleep-timer",
  "title": "Sleep Timer",
  "description": "Put the Mac to sleep in X minutes or at a specific time",
  "icon": "icon.png",
  "author": "michalkonopka",
  "license": "MIT",
  "categories": [
    "System"
  ],
  "commands": [
    {
      "name": "sleep-in",
      "title": "Sleep In",
      "subtitle": "Sleep Timer",
      "description": "Sleep after N minutes (e.g. 30) or at a time (e.g. 23:15)",
      "mode": "no-view",
      "arguments": [
        {
          "name": "when",
          "type": "text",
          "placeholder": "30 or 23:15",
          "required": true
        }
      ]
    },
    {
      "name": "cancel-sleep",
      "title": "Cancel Sleep Timer",
      "subtitle": "Sleep Timer",
      "description": "Cancel the scheduled sleep",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "keywords": [
    "sleep",
    "timer",
    "pmset"
  ]
}
